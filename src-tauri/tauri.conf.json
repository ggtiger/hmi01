{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "XdesinHMI",
  "version": "0.1.2",
  "identifier": "com.xdesin.hmi",
  "build": {
    "beforeBuildCommand": "node scripts/bundle-sidecar.js",
    "beforeDevCommand": "node scripts/ensure-placeholders.js && npm run dev",
    "devUrl": "http://localhost:3200",
    "frontendDist": "./frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "splash.html",
      "icons/icon.png",
      "server/server.js",
      "server/package.json",
      "server/.next/**/*",
      "server/node_modules/**/*",
      "server/public/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBKEY",
      "endpoints": [
        "https://o09u11p5v.qnssl.com/hmi/latest.json?t={{current_version}}"
      ]
    }
  }
}
